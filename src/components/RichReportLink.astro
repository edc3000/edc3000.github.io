---
interface Props {
  href: string;
}
const { href } = Astro.props;
---
<a class="rich-report" href={href}>📄 阅读精排版</a>

<style>
  .rich-report {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid var(--green);
    border-radius: 6px;
    color: var(--green);
    text-decoration: none;
    font-size: 15px;
  }
  .rich-report:hover { background: var(--green); color: var(--paper); }
</style>
