---
interface Props {
  heading: string;
  note?: string;
}
const { heading, note } = Astro.props;
---
<div class="empty">
  <p class="tag">筹备中</p>
  <h2>{heading}</h2>
  {note && <p class="note">{note}</p>}
</div>

<style>
  .empty {
    padding: 32px; margin-top: 24px;
    border: 1px dashed var(--line); border-radius: 8px;
    background: var(--paper-light);
  }
  .tag {
    display: inline-block; margin: 0 0 12px; padding: 3px 10px;
    border-radius: 999px;
    /* var(--gold) 直配 var(--paper) 文字亮色模式对比度仅 2.85(需 ≥4.5),
       用 color-mix 把背景往 --ink 方向加深,同色相降明度 */
    background: color-mix(in srgb, var(--gold) 60%, var(--ink));
    color: var(--paper);
    font-size: 13px;
  }
  .empty h2 { margin: 0; border: none; }
  .note { margin: 12px 0 0; color: var(--muted); }
</style>
