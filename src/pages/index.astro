---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionCard from '../components/SectionCard.astro';
import PostCard from '../components/PostCard.astro';
import { getAllPosts, countBySection, SECTION_LABEL, SECTION_BLURB } from '../lib/collections';

const posts = await getAllPosts();
const counts = await countBySection();
const latest = posts.slice(0, 5);

const sections = (['competitions', 'papers', 'algorithms', 'skills'] as const);
---
<BaseLayout title="Leo" description="Kaggle 竞赛复盘、论文精读、算法实践与 AI Agent 技能包">
  <section class="hero">
    <h1>Leo</h1>
    <p>筑基期·算法工程师</p>
  </section>

  <section class="grid">
    {sections.map((s) => (
      <SectionCard href={`/${s}/`} label={SECTION_LABEL[s]} count={counts[s]} blurb={SECTION_BLURB[s]} />
    ))}
  </section>

  <section>
    <h2>最新</h2>
    {latest.map((p) => (
      <PostCard href={p.href} title={p.title} description={p.description} date={p.date} tags={p.tags} />
    ))}
  </section>
</BaseLayout>

<style>
  .hero { padding-block: 40px 24px; }
  .hero h1 { margin: 0 0 12px; }
  .hero p { margin: 0 0 8px; color: var(--muted); }
  .grid {
    display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    margin-block: 32px;
  }
</style>
