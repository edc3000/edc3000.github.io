---
import KnowledgeLayout from '../../layouts/KnowledgeLayout.astro';
import { getKbTree } from '../../lib/kb-collection';

const tree = await getKbTree();
---
<KnowledgeLayout title="LLMs八股 · Leo" description="大模型面试八股:架构、训练与推理的图解笔记。">
  <h1>LLMs八股</h1>
  <p class="intro">按面试官提问的角度分成六类。每一条只讲一个问题,左侧目录可以直接跳转,也可以用<a href="/search/">全站搜索</a>查关键词。</p>
  <div class="cats">
    {tree.map((cat) => (
      <section class="cat" id={cat.key}>
        <h2>{cat.label}<span class="count">{cat.count > 0 ? `${cat.count} 条` : '筹备中'}</span></h2>
        <p class="blurb">{cat.blurb}</p>
        {cat.count > 0 && (
          <ul>
            {cat.groups.flatMap((g) => g.entries).map((e) => (
              <li><a href={`/interview/${e.id}/`}>{e.title}</a></li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>
</KnowledgeLayout>

<style>
  h1 { margin: 0 0 8px; }
  .intro { margin: 0 0 24px; color: var(--muted); max-width: 62ch; }
  .cats { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .cat {
    padding: 16px 18px; border: 1px solid var(--line); border-radius: 8px;
    background: var(--paper-light);
  }
  .cat h2 {
    display: flex; justify-content: space-between; align-items: baseline; gap: 8px;
    margin: 0 0 4px; font-size: 18px;
  }
  .count { font-size: 12px; font-weight: 400; color: var(--muted); }
  .blurb { margin: 0; font-size: 14px; color: var(--muted); line-height: 1.6; }
  ul { margin: 10px 0 0; padding-left: 1.1em; font-size: 15px; }
</style>
